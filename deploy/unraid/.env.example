# Copy to .env next to docker-compose.yml on Unraid and fill in real values.
# docker compose --env-file .env up -d

# --- Image registry (where build-and-push.sh pushed the images) ---
# Docker Hub example: REGISTRY=docker.io/youruser
# GHCR example:       REGISTRY=ghcr.io/youruser
REGISTRY=192.168.88.2:5000/bookserver
IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_USER=bookserver
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bookserver

# --- Backend security ---
# HS256 signing secret. MUST be >= 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long

# --- Public URL (must match how users reach the frontend) ---
# Used for CORS and for share links + QR codes.
# Replace <unraid-ip> with the server IP or a domain, keep the :8081 port
# (or your reverse-proxy URL, e.g. https://books.example.com without a port).
APP_CORS_ALLOWED_ORIGINS=http://<unraid-ip>:8081
APP_PUBLIC_BASE_URL=http://<unraid-ip>:8081
