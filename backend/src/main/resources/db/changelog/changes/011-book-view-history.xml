<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="011-001-history-settings" author="bookserver">
        <addColumn tableName="site_settings">
            <column name="history_retention_days" type="INTEGER" defaultValueNumeric="365"><constraints nullable="false"/></column>
            <column name="history_max_entries" type="INTEGER" defaultValueNumeric="100"><constraints nullable="false"/></column>
        </addColumn>
    </changeSet>
    <changeSet id="011-002-book-view-history" author="bookserver">
        <createTable tableName="book_view_history">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false" referencedTableName="users" referencedColumnNames="id" deleteCascade="true" foreignKeyName="fk_history_user"/></column>
            <column name="book_id" type="BIGINT"><constraints nullable="false" referencedTableName="books" referencedColumnNames="id" deleteCascade="true" foreignKeyName="fk_history_book"/></column>
            <column name="viewed_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="book_view_history" columnNames="user_id, book_id" constraintName="uk_book_view_history_user_book"/>
        <createIndex tableName="book_view_history" indexName="ix_book_view_history_user_viewed"><column name="user_id"/><column name="viewed_at" descending="true"/></createIndex>
    </changeSet>
</databaseChangeLog>
