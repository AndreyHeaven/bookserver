<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ============================================================ -->
    <!-- 006 - Seed genres (from sql/lib.libgenrelist.sql -> CSV)     -->
    <!--                                                              -->
    <!-- 296 rows = 24 parent section rows (promoted from the source  -->
    <!-- GenreMeta label) + 272 leaf genres (source MySQL dump has    -->
    <!-- 272 unique GenreCode values; gaps exist in GenreId column).  -->
    <!--                                                              -->
    <!-- Ids are explicit in the CSV so that each leaf can point to   -->
    <!-- its parent section via parent_id. Because we insert explicit -->
    <!-- ids into a BIGSERIAL column, the id sequence is realigned     -->
    <!-- afterwards so later inserts (fb2/inpx importers) don't clash. -->
    <!-- ============================================================ -->

    <changeSet id="006-001-seed-genres" author="bookserver">
        <loadData file="db/changelog/seed/genres.csv"
                  tableName="genres"
                  encoding="UTF-8"
                  usePreparedStatements="true">
            <column header="id" name="id" type="NUMERIC"/>
            <column header="code" name="code" type="STRING"/>
            <column header="parent_id" name="parent_id" type="NUMERIC"/>
            <column header="title" name="title" type="STRING"/>
            <column header="meta_section" name="meta_section" type="STRING"/>
            <column header="position" name="position" type="NUMERIC"/>
        </loadData>
        <rollback>
            <delete tableName="genres"/>
        </rollback>
    </changeSet>

    <!-- Realign the BIGSERIAL sequence past the highest explicit id. -->
    <changeSet id="006-002-reset-genres-sequence" author="bookserver">
        <sql>SELECT setval(pg_get_serial_sequence('genres', 'id'), (SELECT MAX(id) FROM genres))</sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
