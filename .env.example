# Copy to .env and adjust before running `docker compose up`.
# .env is git-ignored; .env.example is committed.

# --- PostgreSQL ---
POSTGRES_USER=bookserver
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bookserver

# --- Backend security ---
# HS256 signing secret. MUST be >= 32 characters. Generate e.g. with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long

# Comma-separated list of origins allowed by CORS.
# For the docker-compose stack the SPA is served same-origin via nginx,
# so this can stay minimal; add dev origins when running the frontend separately.
APP_CORS_ALLOWED_ORIGINS=http://localhost

# Public base URL used to build share links + QR codes for public book lists.
APP_PUBLIC_BASE_URL=http://localhost:8080

# --- Storage (paths inside the backend container; backed by named volumes) ---
APP_STORAGE_BOOKS_DIR=/data/books
APP_IMPORTS_BASE_DIR=/data/imports
